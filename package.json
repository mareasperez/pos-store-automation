{
  "name": "my-pos-store-e2e",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Manual-first Playwright E2E suite for my_pos_store",
  "scripts": {
    "test": "node ./scripts/run-playwright-env.mjs --grep \"@parallel\"",
    "test:serial": "node ./scripts/run-playwright-env.mjs --workers=1 --grep \"@serial\"",
    "test:manual": "node ./scripts/run-playwright-env.mjs",
    "test:list": "node ./scripts/run-playwright-env.mjs --list",
    "test:auth:setup": "node ./scripts/create-auth-state.mjs",
    "test:save-state": "node ./scripts/save-playwright-state.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "report": "playwright show-report",
    "report:last": "playwright show-report playwright-report-backup-lastrun",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.3.0",
    "dotenv": "^17.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-playwright": "^2.2.2",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.4"
  }
}
